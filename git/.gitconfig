[alias]
	lg = log --color --graph --pretty=format:'%Cred%C(yellow)%d%Creset %s %Cgreen(%cr)%C(bold blue)<%an>%Creset' --abbrev-commit
	add = add . --all
	l = log --graph --decorate --pretty=oneline --abbrev-commit
	lr = log --reverse --decorate --pretty=oneline --abbrev-commit
	h = log --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%ad) %C(bold blue)<%an>%Creset' --date=relative
	b = branch --avv
	s = status -sb --untracked-files=all
	d = diff --abbrev --minimal --word-diff=color -w -M
	ds = diff --stat
	t = cat-file -t
	p = cat-file -p
	g = grep --break --heading -n
	u = log --stat @{u}..HEAD
	co = checkout
[core]
	pager = delta
[interactive]
	diffFilter = delta --color-only
[delta]
	navigate = true
	side-by-side = true
	line-numbers = true
	syntax-theme = tokyonight_night
[merge]
	conflictStyle = zdiff3
[include]
	# name/email live here (untracked, per machine)
	path = ~/.gitconfig.local
